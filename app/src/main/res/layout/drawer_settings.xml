<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#121622">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Settings"
                android:textColor="#F8FAFC"
                android:textSize="24sp"
                android:textStyle="bold" />
                
            <ImageButton
                android:id="@+id/drawer_close_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#F8FAFC" />
        </RelativeLayout>

        <!-- Language -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Language"
            android:textColor="#94A3B8"
            android:textSize="14sp" />
            
        <Spinner
            android:id="@+id/lang_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#F8FAFC" />

        <!-- Master Mute Toggle -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/master_mute_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mute Announcements"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold"
            app:useMaterialThemeColors="false"
            app:thumbTint="#F8FAFC"
            app:trackTint="@color/switch_track_selector" />
            
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Silences all incoming TTS alerts instantly"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <!-- Volume -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Volume"
                android:textColor="#94A3B8"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/volume_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F8FAFC"
                android:text="15%" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/volume_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:valueFrom="0.0"
            android:valueTo="200.0"
            android:stepSize="1.0"
            app:thumbColor="#F97316"
            app:trackColorActive="#F59E0B"
            app:trackColorInactive="#1FFFFFFF" />

        <!-- Speed -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Speech Speed"
                android:textColor="#94A3B8"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/speed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F8FAFC"
                android:text="1.0x" />
        </LinearLayout>
        <com.google.android.material.slider.Slider
            android:id="@+id/speed_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:valueFrom="0.0"
            android:valueTo="10.0"
            android:stepSize="1.0"
            app:thumbColor="#F97316"
            app:trackColorActive="#F59E0B"
            app:trackColorInactive="#1FFFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#1FFFFFFF" />

        <!-- Sender Name Toggle -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/announce_sender_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Announce Sender Name"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold"
            android:checked="true"
            app:useMaterialThemeColors="false"
            app:thumbTint="#F8FAFC"
            app:trackTint="@color/switch_track_selector" />
        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Reads 'Received ₹50 from Arvind Ji'"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <!-- UPI Apps -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="UPI Apps"
            android:textColor="#94A3B8"
            android:textSize="14sp" />
        <Spinner
            android:id="@+id/upi_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#F8FAFC" />
        <TextView
            android:id="@+id/upi_apps_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="#1FFFFFFF" />

        <!-- SMS Forwarder -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMS Forwarder"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold" />
            
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <EditText
                android:id="@+id/forwarder_number_input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Forward to number"
                android:textColorHint="#475569"
                android:textColor="#F8FAFC"
                android:background="@drawable/input_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="phone" />
                
            <ImageButton
                android:id="@+id/forwarder_eye_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackground"
                android:src="@android:drawable/ic_menu_view"
                android:visibility="gone"
                android:tint="#F8FAFC" />
                
            <Button
                android:id="@+id/forwarder_set_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="Set"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F59E0B" />
        </LinearLayout>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Forward Payment Type"
            android:textColor="#94A3B8"
            android:textSize="14sp" />
        <Spinner
            android:id="@+id/forwarder_type_filter_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#F8FAFC" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Forward App"
            android:textColor="#94A3B8"
            android:textSize="14sp" />
        <Spinner
            android:id="@+id/forwarder_payment_filter_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#F8FAFC" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="#1FFFFFFF" />

        <!-- Test Sounds -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test Sounds"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/test_sound_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Test Default Sound"
            android:textColor="#F8FAFC"
            android:backgroundTint="#1E293B" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/amount_input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Amount"
                android:textColorHint="#475569"
                android:textColor="#F8FAFC"
                android:inputType="numberDecimal"
                android:background="@drawable/input_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
            <Button
                android:id="@+id/test_sound_amount_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="Test Amount"
                android:textColor="#F8FAFC"
                android:backgroundTint="#1E293B" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="#1FFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Info"
            android:textColor="#F8FAFC"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/app_version_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="App Version"
            android:textColor="#F8FAFC"
            android:backgroundTint="#1E293B" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="#1FFFFFFF" />

        <!-- App Language (UI locale — separate from TTS language) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App Language"
                    android:textColor="#F8FAFC"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/app_language_subtitle_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="English"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

            </LinearLayout>

            <Button
                android:id="@+id/app_language_button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Change"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F59E0B"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp" />

    </LinearLayout>
</ScrollView>
